#!/usr/bin/env python3
"""A stand-in for `claude -p --input-format stream-json --output-format stream-json`.

Checks and the VM test point SIDEKICK_CLAUDE_PATH here, so they run without a login, a network or cost.
The lines it prints have the same shape as the real CLI (2.1.x). What it does depends on the question:
  "slow"   streams 40 words slowly, stops early on an interrupt control_request
  "tool"   runs a fake WebSearch first, then answers
  "fail"   ends the turn with is_error and a message
  "crash"  writes to stderr and exits 2
  "long"   a long markdown answer (list, code block, table)
  "stubborn" streams slowly and ignores interrupts (a claude stuck in a tool)
  other    "Echo: <question> (turn N)"
FAKE_CLAUDE_LOG, when set, gets one line with the arguments and one per message.
FAKE_CLAUDE_DELAY scales every pause (default 1).
FAKE_CLAUDE_DEMO=1 answers the README demo questions (see DEMO) with real looking answers, streamed
in small chunks. The question text shows on screen, so the match is on the natural question.
"""
import json, os, random, sys, threading, time

DELAY = float(os.environ.get("FAKE_CLAUDE_DELAY", "1"))
DEMO_MODE = os.environ.get("FAKE_CLAUDE_DEMO") == "1"
SESSION = "00000000-0000-4000-8000-000000000000"
LOG = os.environ.get("FAKE_CLAUDE_LOG")
lock = threading.Lock()
interrupted = threading.Event()


def log(text):
    if LOG:
        with open(LOG, "a") as f:
            f.write(text + "\n")


def emit(obj):
    obj.setdefault("session_id", SESSION)
    with lock:
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()


def stream(event):
    emit({"type": "stream_event", "event": event, "parent_tool_use_id": None})


def pause(seconds):
    time.sleep(seconds * DELAY)


def text_block(index, words, gap=0.0):
    stream({"type": "content_block_start", "index": index, "content_block": {"type": "text", "text": ""}})
    for word in words:
        if interrupted.is_set():
            break
        stream({"type": "content_block_delta", "index": index, "delta": {"type": "text_delta", "text": word}})
        if gap:
            pause(gap)
    stream({"type": "content_block_stop", "index": index})


def result(text, is_error=False, subtype="success"):
    emit({"type": "result", "subtype": subtype, "is_error": is_error, "result": text, "duration_ms": 10})


LONG = """Use `git worktree add` for each task.

Worth knowing:
- Each worktree has its own branch.
- Remove it with `git worktree remove` after the merge.
- Prune stale ones with `git worktree prune`.

```
git -C repo worktree add ../repo-wt/task -b feat/task origin/main
```

| Command | What it does |
| --- | --- |
| add | new worktree |
| prune | clean up |
"""


KITCHEN_ONE = """# Heading 1
## Heading 2
### Heading 3
#### Heading 4

Setext heading
==============

**Bold**, *italic*, ***bold italic***, ~~strike~~, `inline code`, <u>underline</u>, <mark>highlight</mark>, H<sub>2</sub>O, E = mc<sup>2</sup>, <kbd>Cmd</kbd> + <kbd>K</kbd>.

> Blockquote
> > Nested blockquote

> [!NOTE]
> GitHub alert: note.

> [!WARNING]
> GitHub alert: warning.

- Bullet
  - Nested bullet
    - Deeper bullet
1. Ordered
2. List
   1. Nested ordered
- [x] Done task
- [ ] Open task
"""

KITCHEN_TWO = """| Left | Center | Right |
|:--|:-:|--:|
| a | b | c |
| `code` | **bold** | *italic* |

```python
def hello():
    # a comment
    print("fenced code", 42)
```

```diff
- removed line
+ added line
```

Inline link: [Resend](https://resend.com). Reference link: [Docs][docs]. Image: ![alt text](https://example.com/a.png)

[docs]: https://resend.com/docs

Footnote reference[^1].

Term
: Definition list

<details>
<summary>Collapsible section</summary>

Hidden content.
</details>

Math: $e^{i\\pi} + 1 = 0$

$$
\\sum_{n=1}^{\\infty} \\frac{1}{n^2} = \\frac{\\pi^2}{6}
$$

Emoji: :rocket: :tada:

---

[^1]: The footnote text.
"""


# break-ui worst cases: plausible values a real answer or question can carry, all at once.
WORST_TEXT = """## Notes for Aleksandra Wiśniewska-Kowalczyk on the Northwind Industries Holdings renewal, third revision

Send it to bartholomew.fitzgerald@northwind-industries-holdings.example.com and cc Jo.

The signed copy: https://northwind-industries-holdings.example.com/contracts/2026/renewals/enterprise/NW-2026-0001284-final-v12-signed-countersigned.pdf?download=1&utm_source=sidekick

Commit `4f9c2a7e1b3d5c8f0a6e2d4b7c9f1a3e5d7b9c0f2a4e6d8b1c3f5a7e9d0b2c4f6` holds the fix.

Tiếng Việt: Nguyễn Thị Phương Thảo đã xác nhận. ภาษาไทย: ยืนยันแล้ว. العربية: تم التأكيد من الفريق.
Family: 👨‍👩‍👧‍👦 🏳️‍🌈 🧑🏽‍💻

1284. The 1,284th member joined today.
1285. And one more.

- Level one with a long item that keeps going so it has to wrap onto a second line in a narrow panel
  - Level two
    - Level three
      - Level four
        - Level five
          - Level six, deepest
- [ ] Ask Bartholomew Fitzgerald-Montgomery III to countersign the enterprise renewal before the quarter closes

| Customer | Plan | Seats | MRR | Owner | Next step |
| --- | --- | --- | --- | --- | --- |
| Northwind Industries Holdings | Enterprise annual | 1,284 | $48,250.00 | Aleksandra Wiśniewska-Kowalczyk | Countersign the renewal and send the invoice |
| Jo | Pro | 1 | $20.00 | Jo | — |

> A quote that holds an alert
> > [!CAUTION]
> > Nested caution inside a quote.

```bash
curl -X POST https://api.northwind-industries-holdings.example.com/v2/workspaces/ws_01HZX4Q8YQ7K3M9N2P5R6S8T0V/members/bulk-invite --data '{"emails":["bartholomew.fitzgerald@northwind-industries-holdings.example.com"]}'
```
"""

WORST_BIG = "\n\n".join(
    f"Paragraph {i}: " + " ".join(f"word{i}-{j}" for j in range(30)) for i in range(100)
) + "\n\n" + "\n".join(f"- item {i} of the long list" for i in range(150))


# The README demo (FAKE_CLAUDE_DEMO=1): (words the question must hold, web search query or None, answer).
DEMO = [
    (("time difference", "san francisco", "tokyo"), "SF Tokyo time difference",
     """Tokyo is **16 hours ahead** of San Francisco right now.

Worth knowing:
- The gap becomes **17 hours** when the US ends daylight saving on Nov 1.
- 9 AM in SF is 1 AM the next day in Tokyo.
- Japan does not observe daylight saving.
"""),
]


def demo_answer(q):
    """Streams a demo answer when the question matches one. Returns False when none does."""
    for words, query, body in DEMO:
        if not all(word in q for word in words):
            continue
        index = 0
        if query:
            stream({"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "toolu_demo", "name": "WebSearch", "input": {}}})
            stream({"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": json.dumps({"query": query})}})
            stream({"type": "content_block_stop", "index": 0})
            pause(0.9)
            index = 1
        else:
            pause(0.5)
        # Small uneven chunks with small gaps, like a fast model's stream. Seeded, so takes repeat.
        # A **bold** or `code` span goes out whole, so no raw asterisks flash on screen.
        rng = random.Random(len(body))
        chunks, at = [], 0
        while at < len(body):
            end = at + rng.randint(2, 7)
            for mark in ("**", "`"):
                start = body.find(mark, at, end)
                if start != -1 and not body.startswith("```", start):
                    close = body.find(mark, start + len(mark))
                    end = max(end, close + len(mark)) if close != -1 else end
            chunks.append(body[at:end])
            at = end
        text_block(index, chunks, gap=0.022)
        result(body)
        return True
    return False


def answer(question, turn):
    interrupted.clear()
    emit({"type": "system", "subtype": "init", "cwd": os.getcwd(), "tools": ["Read", "WebSearch"], "parent_tool_use_id": None})
    # A subagent line must be ignored by the app.
    emit({"type": "stream_event", "parent_tool_use_id": "toolu_sub", "event": {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "SUBAGENT TEXT"}}})
    stream({"type": "message_start", "message": {"model": "claude-fake-9-9", "role": "assistant", "content": []}})
    q = question.lower()
    if DEMO_MODE and demo_answer(q):
        return
    if "crash" in q:
        sys.stderr.write("fake-claude: crashed on purpose\n")
        sys.stderr.flush()
        os._exit(2)
    if "fail" in q:
        pause(0.1)
        result("Not logged in. Run claude in Terminal and log in.", is_error=True, subtype="error_during_execution")
        return
    if "tool" in q:
        stream({"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "toolu_1", "name": "WebSearch", "input": {}}})
        stream({"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": "{\"query\": \"swift "}})
        stream({"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": "release date\"}"}})
        stream({"type": "content_block_stop", "index": 0})
        pause(0.6)
        text_block(1, ["Swift 6.4 ", "shipped ", "in 2026."])
        result("Swift 6.4 shipped in 2026.")
        return
    if "stubborn" in q:
        stream({"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}})
        for i in range(30):
            stream({"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": f"late{i} "}})
            pause(0.1)
        result("stubborn done")
        return
    if "slow" in q:
        words = [f"word{i} " for i in range(40)]
        text_block(0, words, gap=0.08)
        if interrupted.is_set():
            result(None, is_error=True, subtype="error_during_execution")
        else:
            result("".join(words))
        return
    if "worst" in q:
        if "empty" in q:
            result("")
            return
        if "blank" in q:
            text_block(0, ["   ", "\n\n  "])
            result("   \n\n  ")
            return
        if "error" in q:
            result("API Error: 529 {\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"},\"request_id\":\"req_011CXYZ4Q8YQ7K3M9N2P5R6S8T0V\"} while running mcp__claude_ai_Linear__list_issues for /Users/aleksandra.wisniewska-kowalczyk/Workbench/work/projects/northwind-industries-holdings-renewal", is_error=True, subtype="error_during_execution")
            return
        body = WORST_BIG if "big" in q else WORST_TEXT
        # Real streams send small chunks: about 4 characters on average for a fast model.
        size = 12 if "big" in q else 24
        chunks = [body[i:i + size] for i in range(0, len(body), size)]
        text_block(0, chunks, gap=0.003 if "big" in q else 0.0)
        result(body)
        return
    if "kitchen" in q:
        body = KITCHEN_ONE if "one" in q else KITCHEN_TWO
        chunks = [body[i:i + 40] for i in range(0, len(body), 40)]
        text_block(0, chunks, gap=0.01)
        result(body)
        return
    if "long" in q:
        chunks = [LONG[i:i + 12] for i in range(0, len(LONG), 12)]
        text_block(0, chunks, gap=0.02)
        result(LONG)
        return
    pause(0.15)
    reply = f"Echo: {question} (turn {turn})"
    text_block(0, [reply[:6], reply[6:]])
    result(reply)


def main():
    log("args " + json.dumps(sys.argv[1:]) + " cwd " + os.getcwd())
    log("env " + " ".join(k for k in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDECODE") if k in os.environ))
    # Real claude runs SessionStart hooks before the first message arrives.
    emit({"type": "system", "subtype": "hook_started", "hook_name": "SessionStart:startup"})
    turn = 0
    worker = None
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        message = json.loads(line)
        if message.get("type") == "control_request":
            log("interrupt")
            interrupted.set()
            emit({"type": "control_response", "response": {"subtype": "success", "request_id": message.get("request_id")}})
            continue
        if message.get("type") == "user":
            if worker:
                worker.join()
            turn += 1
            question = message["message"]["content"]
            log("user " + question)
            worker = threading.Thread(target=answer, args=(question, turn))
            worker.start()
    if worker:
        worker.join()
    log("eof")


main()
